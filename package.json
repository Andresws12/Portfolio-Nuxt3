{
  "name": "Portfolio-Nuxt3",
  "type": "module",
  "private": true,
  "scripts": {
    "build": "nuxt build",
    "dev": "nuxt dev",
    "generate": "nuxt generate",
    "preview": "nuxt preview",
    "format:check": "prettier --list-different \"./**/*.?(vue|ts|js|scss|html|json)\"",
    "format": "prettier --write \"./**/*.?(vue|ts|js|scss|html|json)\"",
    "lint:eslint": "eslint .",
    "lint:stylelint": "stylelint \"**/*.{css,scss,vue}\"",
    "lint": "pnpm lint:eslint && pnpm lint:stylelint && pnpm format:check",
    "lint:fix": "eslint . --fix && stylelint \"**/*.{css,scss,vue}\" --fix && pnpm format",
    "check:all": "pnpm lint",
    "postinstall": "nuxt prepare"
  },
  "dependencies": {
    "@nuxt/eslint": "1.11.0",
    "@nuxt/hints": "1.0.0-alpha.3",
    "@nuxt/image": "2.0.0",
    "@nuxtjs/i18n": "10.2.1",
    "@nuxtjs/stylelint-module": "5.2.1",
    "@pinia/nuxt": "0.11.3",
    "eslint": "^9.39.1",
    "nuxt": "^4.2.1",
    "nuxt-schema-org": "5.0.9",
    "pinia": "^3.0.4",
    "vue": "^3.5.25",
    "vue-router": "^4.6.3"
  },
  "devDependencies": {
    "@nuxtjs/robots": "^5.6.1",
    "@nuxtjs/sitemap": "^7.4.8",
    "eslint-config-prettier": "^10.1.8",
    "postcss-html": "^1.8.0",
    "prettier": "^3.7.4",
    "sass": "^1.94.2",
    "stylelint": "^16.26.1",
    "stylelint-config-recommended-vue": "^1.6.1",
    "stylelint-config-standard-scss": "^16.0.0"
  }
}
